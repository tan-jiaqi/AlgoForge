          "customer_id"
        ]
      },
      "origin": "extracted",
      "executable": false,
      "code": "def drop_id_columns(df, id_cols=(\"customer_id\",)):\n    \"\"\"删除客户 ID 等高基数标识列，避免被当作类别特征做 one-hot 导致维度爆炸。\"\"\"\n    return df.drop(columns=[c for c in id_cols if c in df.columns])"
    },
    {
      "id": "Operator:KFoldTargetEncoder@1",
      "type": "Operator",
      "key": "KFoldTargetEncoder@1",
      "name": "KFoldTargetEncoder",
      "version": 1,
      "kind": "encoder",
      "modalities": [
        "tabular"
      ],
      "description": "对高基数类别特征进行带平滑的K折折外目标编码，防止训练集标签泄漏并增强对罕见类别的泛化能力。",
      "inputs": "训练集DataFrame、测试集DataFrame、待编码类别列名、目标列名",
      "outputs": "训练集和测试集编码后的Series元组",
      "params": {
        "target": "churn",
        "n_splits": 5,
        "smoothing": 10
      },
      "origin": "extracted",
      "executable": false,
      "code": "def target_encode(train, test, col, target=\"churn\", n_splits=5, smoothing=10):\n    \"\"\"对高基数类别列做 K 折目标编码（带平滑）。\n\n    注意：必须只在训练集内做折外编码再映射到测试集，否则会标签泄漏。\n    2024-03 的实验里曾在全量数据上直接编码，AUC 虚高到 0.97，上线后崩到 0.71。\n    \"\"\"\n    prior = train[target].mean()\n    train_enc = pd.Series(index=train.index, dtype=float)\n    for fit_idx, val_idx in KFold(n_splits, shuffle=True, random_state=0).split(train):\n        stats = train.iloc[fit_idx].groupby(col)[target].agg([\"mean\", \"count\"])\n        smooth = (stats[\"mean\"] * stats[\"count\"] + prior * smoothing) / (stats[\"count\"] + smoothing)\n        train_enc.iloc[val_idx] = train.iloc[val_idx][col].map(smooth).fillna(prior).values\n    stats = train.groupby(col)[target].agg([\"mean\", \"count\"])\n    smooth = (stats[\"mean\"] * stats[\"count\"] + prior * smoothing) / (stats[\"count\"] + smoothing)\n    return train_enc, test[col].map(smooth).fillna(prior)"
    },
