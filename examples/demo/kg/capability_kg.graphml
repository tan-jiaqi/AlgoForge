    <node id="Operator:TotalChargesCleaner@1">
      <data key="d0">Operator</data>
      <data key="d1">TotalChargesCleaner@1</data>
      <data key="d10">TotalChargesCleaner</data>
      <data key="d11">1</data>
      <data key="d12">imputer</data>
      <data key="d13">["tabular"]</data>
      <data key="d2">将包含空白字符串的数值列安全转换为浮点型，并将缺失及空白值填充为0.0</data>
      <data key="d14">包含目标字符串数值列的 DataFrame</data>
      <data key="d15">目标列已转为浮点型且缺失值填充为0.0的 DataFrame</data>
      <data key="d16">{"col": "total_charges"}</data>
      <data key="d9">extracted</data>
      <data key="d17">False</data>
      <data key="d18">def clean_total_charges(df, col="total_charges"):
    """把累计消费列从字符串转为数值。

    新入网客户的 total_charges 为空白字符串，直接 astype(float) 会报
    ValueError: could not convert string to float。这里先 strip 再
    to_numeric(errors="coerce")，空值用 0 填充（新客户尚未产生消费）。
    """
    out = df.copy()
    out[col] = pd.to_numeric(out[col].astype(str).str.strip(), errors="coerce").fillna(0.0)
    return out</data>
    </node>
    <node id="Operator:TotalChargesCleaner@2">
      <data key="d0">Operator</data>
      <data key="d1">TotalChargesCleaner@2</data>
      <data key="d10">TotalChargesCleaner</data>
      <data key="d11">2</data>
      <data key="d12">imputer</data>
      <data key="d13">["tabular"]</data>
      <data key="d2">清洗包含空白字符串的数值列并转换为浮点型，缺失值填充为指定值</data>
      <data key="d14">pandas.DataFrame</data>
      <data key="d15">pandas.DataFrame</data>
      <data key="d16">{"column": "total_charges", "fill_value": 0.0}</data>
      <data key="d9">synthesized</data>
      <data key="d17">True</data>
      <data key="d18">import numpy as np
import pandas as pd
from sklearn.base import TransformerMixin
from factory.operators.base import Operator, OperatorMeta
from factory.schemas import OperatorKind


class TotalChargesCleaner(TransformerMixin, Operator):
    meta = OperatorMeta(
        name="TotalChargesCleaner",
        kind=OperatorKind.IMPUTER,
        version=2,
        origin="synthesized",
        description="清洗包含空白字符串的数值列并转换为浮点型，缺失值填充为指定值",
        conditions=["string_typed_numeric", "has_missing_values"],
        dependencies=[],
        params={"column": "total_charges", "fill_value": 0.0},
        parent="TotalChargesCleaner@1",
    )

    def __init__(self, column: str = "total_charges", fill_value: float = 0.0):
        self.column = column
        self.fill_value = fill_value

    def fit(self, X: pd.DataFrame, y=None):
        self.feature_names_in_ = list(X.columns)
        self.column_present_ = self.column in X.columns
        return self

    def transform(self, X: pd.DataFrame) -&gt; pd.DataFrame:
        X = X.copy()
        if self.column in X.columns:
            cleaned = pd.to_numeric(
                X[self.column].astype(str).str.strip(),
                errors="coerce"
            ).fillna(self.fill_value)
            X[self.column] = cleaned.astype(float)
        return X
</data>
